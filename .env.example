# Copy to .env.local and edit. Vite only exposes vars prefixed with VITE_.
#
# NOTE: these are inlined into the JavaScript bundle at build time, so they are
# public by definition. That is fine for Firebase web config — the Firebase API
# key identifies the project, it does not authorise anything. Access is decided
# by Firestore security rules (see firestore.rules) and by who is signed in.
# Never put a service account key or an admin secret in here.

# Which data adapter the app uses:
#   local     browser localStorage, no server (default)
#   firebase  Firestore + Google sign-in
#   remote    a plain HTTP backend of your own
VITE_DATA_BACKEND=local

# --- firebase backend ---------------------------------------------------
# From the Firebase console: Project settings > General > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- remote backend -----------------------------------------------------
# Base URL for the remote adapter. Only used when VITE_DATA_BACKEND=remote.
VITE_API_URL=/api
